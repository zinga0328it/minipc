#!/usr/bin/env bash
# etc-deploy: unico punto di scrittura privilegiata autorizzato su /etc.
# Installato come /usr/local/sbin/etc-deploy (root:root 0755), invocato con `sudo -n`.
#
#   etc-deploy install <percorso>   < contenuto   installa un file autorizzato (backup, check, rollback)
#   etc-deploy check <servizio>                   valida la configurazione
#   etc-deploy reload <servizio>                  ricarica/riavvia (nftables|apache2|fail2ban|tor)
#   etc-deploy rollback [id]                      ripristina l'ultimo (o l'id indicato) backup
#   etc-deploy list                               elenca i backup
#   etc-deploy verify                             verifica globale in sola lettura
#
# Il contenuto arriva da stdin: nessun file sorgente controllato dall'utente viene letto da root.
set -euo pipefail
umask 077

readonly PREFIX=""                        # @TEST-HOOK:prefix
readonly ROOT_UID=0                       # @TEST-HOOK:uid
export PATH=/usr/sbin:/usr/bin:/sbin:/bin # @TEST-HOOK:path
export LC_ALL=C
unset BASH_ENV ENV

readonly STATE="$PREFIX/var/lib/etc-deploy"
readonly BACKUPS="$PREFIX/var/backups/etc-deploy"
readonly LOG="$PREFIX/var/log/etc-deploy.log"
readonly MAX_BYTES=262144
readonly NAME='[A-Za-z0-9][A-Za-z0-9._-]*'

log() {
  printf '%s user=%s %s\n' "$(date -Is)" "${SUDO_USER:-${USER:-?}}" "$*" >>"$LOG" 2>/dev/null || true
  printf '%s\n' "$*" >&2
}
die() {
  log "ERRORE: $*"
  exit 1
}

require_root() { # @TEST-HOOK:root
  [[ $EUID -eq 0 ]] || die "serve root (usare sudo -n)"
}

put() {                                                 # sorgente destinazione modo utente:gruppo
  install -m "$3" -o "${4%%:*}" -g "${4##*:}" "$1" "$2" # @TEST-HOOK:put
}

TMP=""
trap 'rm -f -- "${TMP:-/nonexistent}"' EXIT

init_state() {
  install -d -m 0700 "$STATE" "$BACKUPS"
  : >>"$LOG"
  chmod 0640 "$LOG"
  exec 9>"$STATE/lock"
  flock -n 9 || die "un'altra operazione e' in corso"
}

# --- politica: percorso -> servizio ---------------------------------------
service_of() {
  local p=$1 re
  case $p in
    /etc/nftables.conf)
      echo nftables
      return 0
      ;;
    /etc/apache2/ports.conf)
      echo apache2
      return 0
      ;;
    /etc/tor/torrc)
      echo tor
      return 0
      ;;
    /etc/AGENTS.md)
      echo docs
      return 0
      ;;
  esac
  re="^/etc/nftables/(services/)?$NAME\.conf$"
  [[ $p =~ $re ]] && {
    echo nftables
    return 0
  }
  re="^/etc/apache2/(sites-available|conf-available|honeypot)/$NAME\.(conf|inc)$"
  [[ $p =~ $re ]] && {
    echo apache2
    return 0
  }
  re="^/etc/fail2ban/(jail\.d/$NAME\.(local|conf)|filter\.d/$NAME\.conf)$"
  [[ $p =~ $re ]] && {
    echo fail2ban
    return 0
  }
  re='^/etc/(nftables|apache2|fail2ban|tor|yggdrasil)/AGENTS\.md$'
  [[ $p =~ $re ]] && {
    echo docs
    return 0
  }
  re="^/etc/\.github/agents/$NAME\.agent\.md$"
  [[ $p =~ $re ]] && {
    echo docs
    return 0
  }
  return 1
}

# Ogni directory fino a /etc deve essere reale, di root e non scrivibile da altri.
check_path_safety() {
  local target=$1 real=$PREFIX$1 d perm
  [[ $target == /* && $target != *..* ]] || die "percorso non valido: $target"
  d=$(dirname "$real")
  while [[ $d != / && $d != "$PREFIX" ]]; do
    [[ -d $d && ! -L $d ]] || die "directory non valida o symlink: $d"
    [[ $(stat -c %u "$d") -eq $ROOT_UID ]] || die "directory non di root: $d"
    perm=$(stat -c %a "$d")
    ((($((8#$perm)) & 8#022) == 0)) || die "directory scrivibile da altri: $d"
    d=$(dirname "$d")
  done
  if [[ -e $real || -L $real ]]; then
    [[ -f $real && ! -L $real ]] || die "il bersaglio non e' un file regolare: $target"
  fi
}

# --- filtri sul contenuto: bloccano direttive che eseguono codice o scrivono altrove ---
content_denied() { # servizio file -> stampa il motivo e fallisce se vietato
  local svc=$1 f=$2 body
  body=$(grep -vE '^[[:space:]]*#' "$f" || true)
  local -a rules=()
  case $svc in
    apache2)
      rules=(
        '^\s*(LoadModule|LoadFile|PerlRequire|PerlModule|PidFile|ScoreBoardFile|User|Group|CoreDumpDirectory|ExtFilterDefine|SSLPassPhraseDialog|Mutex|DefaultRuntimeDir|ServerRoot)\b'
        '^\s*RewriteMap\s+\S+\s+prg:'
        '^\s*(ErrorLog|CustomLog|TransferLog|ForensicLog)\s+"?(?!\$\{APACHE_LOG_DIR\}/|/var/log/apache2/|syslog)'
        '^\s*(Include|IncludeOptional)\s+"?(?!/etc/apache2/)'
      )
      ;;
    fail2ban)
      rules=(
        '^\s*(ignorecommand|action(ban|unban|start|stop|check))\s*='
        '^\s*(before|after)\s*=.*/'
      )
      ;;
    tor)
      rules=(
        '^\s*(%include|User|RunAsDaemon|PidFile|DataDirectory|ControlPort|ControlSocket|Sandbox|ClientTransportPlugin|ServerTransportPlugin|__\w+)\b'
        '^\s*Log\s+\S+\s+file\b'
        '^\s*HiddenServiceDir\s+(?!/var/lib/tor/)'
      )
      ;;
    nftables)
      rules=('^\s*include\s+"?(?!/etc/nftables(/|\.conf))')
      ;;
  esac
  local r
  for r in "${rules[@]}"; do
    if grep -Piq -- "$r" <<<"$body"; then
      echo "direttiva vietata per $svc: /$r/"
      return 0
    fi
  done
  return 1
}

# --- controlli di servizio -------------------------------------------------
# Come ExecStartPre di tor@default: serve il file di default del servizio (User debian-tor).
tor_verify() {
  tor --defaults-torrc "$PREFIX/usr/share/tor/tor-service-defaults-torrc" -f "$PREFIX/etc/tor/torrc" --RunAsDaemon 0 --verify-config
}
svc_check() {
  case $1 in
    nftables) nft -c -f "$PREFIX/etc/nftables.conf" ;;
    apache2) apache2ctl configtest ;;
    fail2ban) fail2ban-client -t >/dev/null ;;
    tor) tor_verify >/dev/null ;;
    docs) return 0 ;;
    *) die "servizio non autorizzato: $1" ;;
  esac
}

ssh_ok() {
  [[ $(ss -lnt) == *":22 "* && $(nft list chain inet filter input 2>/dev/null) == *"dport 22"* ]]
}

svc_reload() {
  case $1 in
    nftables)
      svc_check nftables
      systemctl reload nftables
      ssh_ok || return 1
      fail2ban-client reload >/dev/null # flush ruleset cancella le tabelle di fail2ban
      ;;
    apache2)
      svc_check apache2
      systemctl reload apache2
      ;;
    fail2ban)
      svc_check fail2ban
      fail2ban-client reload >/dev/null
      ;;
    tor)
      svc_check tor
      systemctl restart tor@default
      systemctl is-active --quiet tor@default
      ;;
    *) die "servizio non autorizzato: $1" ;;
  esac
}

# --- backup / rollback -------------------------------------------------------
latest_id() { find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | tail -1; }

restore_id() {
  local id=$1 dir="$BACKUPS/$1" kind path mode own n=0
  [[ $id =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ && -f $dir/manifest ]] || die "backup inesistente: $id"
  while read -r kind path mode own; do
    service_of "$path" >/dev/null || die "manifest con percorso non autorizzato: $path"
    case $kind in
      existing) put "$dir/files/$n" "$PREFIX$path" "$mode" "$own" ;;
      created) rm -f -- "$PREFIX$path" ;;
    esac
    n=$((n + 1))
  done <"$dir/manifest"
  log "ripristinato backup $id"
}

cmd_install() {
  local target=${1:-} svc tmp id dir mode own why real
  [[ -n $target ]] || die "uso: etc-deploy install <percorso> < contenuto"
  svc=$(service_of "$target") || die "percorso non autorizzato: $target"
  check_path_safety "$target"
  real=$PREFIX$target

  tmp=$(mktemp -p "$STATE")
  TMP=$tmp
  head -c $((MAX_BYTES + 1)) >"$tmp"
  [[ $(stat -c %s "$tmp") -le $MAX_BYTES ]] || die "contenuto oltre $MAX_BYTES byte"
  [[ $(tr -d '\0' <"$tmp" | wc -c) -eq $(wc -c <"$tmp") ]] || die "contenuto binario non ammesso"
  [[ -s $tmp ]] || die "contenuto vuoto"
  if why=$(content_denied "$svc" "$tmp"); then die "$why"; fi

  id="$(date +%Y%m%d-%H%M%S)-$$"
  dir="$BACKUPS/$id"
  install -d -m 0700 "$dir/files"
  if [[ -e $real ]]; then
    mode=$(stat -c %a "$real")
    own=$(stat -c %U:%G "$real")
    cp -p -- "$real" "$dir/files/0"
    printf 'existing %s %s %s\n' "$target" "$mode" "$own" >"$dir/manifest"
  else
    mode=644
    own=root:root
    printf 'created %s %s %s\n' "$target" "$mode" "$own" >"$dir/manifest"
  fi

  put "$tmp" "$real.new.$$" "$mode" "$own"
  mv -T -- "$real.new.$$" "$real"
  if ! svc_check "$svc"; then
    restore_id "$id"
    die "validazione $svc fallita: ripristinato $target"
  fi
  log "installato $target (servizio=$svc backup=$id)"
  echo "OK installato $target backup=$id"
}

cmd_rollback() {
  local id=${1:-$(latest_id)}
  [[ -n $id ]] || die "nessun backup"
  restore_id "$id"
  echo "OK ripristinato $id (ricarica con: etc-deploy reload <servizio>)"
}

cmd_list() { find "$BACKUPS" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort; }

cmd_verify() {
  local rc=0 s
  step() {
    local label=$1
    shift
    if "$@" >/dev/null 2>&1; then echo "OK   $label"; else
      echo "FAIL $label"
      rc=1
    fi
  }
  step "nft -c" nft -c -f "$PREFIX/etc/nftables.conf"
  step "apache2 configtest" apache2ctl configtest
  step "fail2ban -t" fail2ban-client -t
  step "sshd -t" sshd -t
  step "tor verify-config" tor_verify
  step "ssh in ascolto" bash -c "[[ \$(ss -lnt) == *':22 '* ]]"
  for s in apache2 tor@default fail2ban nftables ssh yggdrasil; do
    step "servizio $s attivo" systemctl is-active --quiet "$s"
  done
  return "$rc"
}

main() {
  local op=${1:-}
  shift || true
  require_root
  init_state
  case $op in
    install) cmd_install "$@" ;;
    check)
      svc_check "${1:-}"
      echo "OK"
      ;;
    reload)
      svc_reload "${1:-}" || {
        log "ricarica ${1:-} fallita: ripristino ultimo backup"
        restore_id "$(latest_id)"
        svc_reload "${1:-}" || true
        exit 1
      }
      log "ricaricato ${1:-}"
      echo "OK ricaricato ${1:-}"
      ;;
    rollback) cmd_rollback "$@" ;;
    list) cmd_list ;;
    verify) cmd_verify ;;
    *) die "uso: etc-deploy {install <percorso>|check <srv>|reload <srv>|rollback [id]|list|verify}" ;;
  esac
}

main "$@"
