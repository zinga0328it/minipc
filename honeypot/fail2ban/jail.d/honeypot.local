[honeypot]
# Solo registrazione dei candidati (azione honeypot-log), nessun ban.
enabled = true
filter = honeypot
logpath = /var/log/apache2/honeypot.log
backend = auto
# Falsi positivi: servono 3 richieste esca in 10 minuti, non una sola.
maxretry = 3
findtime = 10m
bantime = 1d
ignoreip = 127.0.0.1/8 ::1
action = honeypot-log
